<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="http://jeremylong.github.io/DependencyCheck/dependency-check-suppression.1.2.xsd">
    <!--
        OWASP Dependency-Check Suppression File
        
        This file suppresses false positives and known vulnerabilities that are:
        - Not applicable to our runtime environment
        - Already mitigated by application-level security
        - Below our CVSS threshold but logged for awareness
    -->
    
    <!-- Suppressions for development-only dependencies -->
    <suppress>
        <notes>
            <![CDATA[
                H2 database is only used in test scope, not in production
            ]]>
        </notes>
        <packageUrl regex="true">^pkg:maven/com\.h2database/h2@.*$</packageUrl>
        <cve>CVE-2023-44617</cve>
    </suppress>
    
    <!-- Testcontainers is test-only dependency -->
    <suppress>
        <notes>
            <![CDATA[
                Testcontainers is only used in test scope
            ]]>
        </notes>
        <packageUrl regex="true">^pkg:maven/org\.testcontainers/.*@.*$</packageUrl>
    </suppress>
    
    <!-- Lombok is compile-time only, generates code -->
    <suppress>
        <notes>
            <![CDATA[
                Lombok is a compile-time annotation processor, not runtime dependency
            ]]>
        </notes>
        <packageUrl regex="true">^pkg:maven/org\.projectlombok/lombok@.*$</packageUrl>
    </suppress>
    
    <!-- Spring Boot managed dependencies - vulnerabilities will be fixed by Spring releases -->
    <suppress>
        <notes>
            <![CDATA[
                Managed by Spring Boot BOM, will be updated with next Spring Boot release
            ]]>
        </notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/.*@.*$</packageUrl>
    </suppress>
</suppressions>
