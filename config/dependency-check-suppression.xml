<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd">
    <!--
        OWASP Dependency-Check Suppression File
        Suppresses CVEs in dependencies managed by Spring Boot BOM 3.3.6
        until Spring Boot is upgraded.
    -->

    <!-- Spring Framework (Spring Boot 3.3.6 manages these) -->
    <suppress>
        <notes><![CDATA[Managed by Spring Boot BOM]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/.*@.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>
    <suppress>
        <notes><![CDATA[Managed by Spring Boot BOM]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/.*@.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>
    <suppress>
        <notes><![CDATA[Managed by Spring Boot BOM]]></notes>
