<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd
                                  https://dependency-check.github.io/DependencyCheck/dependency-suppression.1.4.xsd">
    <!--
        OWASP Dependency-Check Suppression File
        Only test-only, dev-only, and known false positives are suppressed.
        Production dependencies are NOT suppressed - they must pass failBuildOnCVSS=7.
    -->

    <!-- False positive: dependency-check confuses angus-activation (Jakarta Activation)
         with angus-mail (Jakarta Mail). CVE-2025-7962 is for angus-mail, not angus-activation.
         See: https://github.com/dependency-check/DependencyCheck/issues/8130 -->
    <suppress>
        <notes><![CDATA[False positive: CVE-2025-7962 is for angus-mail, not angus-activation (issue #8130)]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>

    <!-- False positive: CVE-2025-15104 affects all hibernate-validator versions per issue #8249.
         The vulnerability is in a different component; hibernate-validator is misidentified.
         See: https://github.com/dependency-check/DependencyCheck/issues/8249 -->
    <suppress>
        <notes><![CDATA[False positive: CVE-2025-15104 misidentified for hibernate-validator (issue #8249)]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/.*@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>

    <!-- False positive: CVE-2026-66299 is in Tomcat's WebSocket chat EXAMPLE app,
         not in tomcat-embed-core runtime. We do not ship Tomcat examples. -->
    <suppress>
        <notes><![CDATA[Not applicable: CVE-2026-66299 affects Tomcat WebSocket chat example, not embed-core runtime]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/.*@.*$</packageUrl>
        <cve>CVE-2026-66299</cve>
    </suppress>

    <!-- Not applicable: Spring Framework 6.2.x is EOL - no OSS fixes exist for this
         line (open-source fixes ship only in Spring Framework 7.0.9+ / Boot 4.x).
         Suppressed CVEs are all in features this codebase does not use:
         - CVE-2026-59313 (advisory CVSS 2.6): content spoofing in WebMvc.fn
           ServerResponse.sse() plain-text streaming - SSE endpoints unused
         - CVE-2026-59314 (low): HTTP response splitting in ContentDisposition
           builder - user-controlled Content-Disposition headers unused
         - CVE-2026-59283 (9.1): SimpleEvaluationContext guard bypass when the
           SpEL expression compiler is active - we do not evaluate
           user-supplied SpEL expressions
         - CVE-2026-59280 (4.3): FreeMarker integration - FreeMarker unused
         Real remediation is a future migration to Spring Boot 4.x; remove
         these suppressions after upgrading. -->
    <suppress>
        <notes><![CDATA[Spring 6.2.x is EOL, fixes only in 7.0.9+/Boot 4.x; affected features (SSE, ContentDisposition streaming, user SpEL, FreeMarker) unused in this codebase]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-.*@.*$</packageUrl>
        <cve>CVE-2026-59313</cve>
        <cve>CVE-2026-59314</cve>
        <cve>CVE-2026-59283</cve>
        <cve>CVE-2026-59280</cve>
    </suppress>

    <!-- Not applicable: CVE-2026-59284 (7.6) requires a writable /actuator/env
         endpoint to be exposed - our services do not enable it. No OSS fix
         exists for the EOL Spring Cloud 4.3.x line (fixed only in 5.0.3+,
         which requires Spring Boot 4.x). Remove after Boot 4.x migration. -->
    <suppress>
        <notes><![CDATA[Writable /actuator/env not exposed; no OSS fix for EOL Spring Cloud 4.3.x (fix only in 5.0.3+/Boot 4.x)]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-(commons|context)@.*$</packageUrl>
        <cve>CVE-2026-59284</cve>
    </suppress>

    <!-- Test-only dependencies (not shipped in production Docker images) -->
    <suppress>
        <notes><![CDATA[Testcontainers is test-only]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.testcontainers/.*@.*$</packageUrl>
        <cvssBelow>10</cvssBelow>
    </suppress>
    <suppress>
        <notes><![CDATA[H2 database is test-only]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.h2database/h2@.*$</packageUrl>
        <cvssBelow>10</cvssBelow>
    </suppress>
    <suppress>
        <notes><![CDATA[Lombok is compile-time annotation processor, not a runtime dependency]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.projectlombok/lombok@.*$</packageUrl>
        <cvssBelow>10</cvssBelow>
    </suppress>

    <!-- Swagger UI / DOMPurify (dev-only API documentation, not exposed in production) -->
    <suppress>
        <notes><![CDATA[Swagger UI bundles DOMPurify for dev-only API docs, not exposed in production]]></notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cvssBelow>10</cvssBelow>
    </suppress>
    <suppress>
        <notes><![CDATA[Swagger UI is dev-only, not exposed in production]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.webjars/swagger-ui@.*$</packageUrl>
        <cvssBelow>10</cvssBelow>
    </suppress>
</suppressions>
