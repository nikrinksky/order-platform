<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd">
    <!--
        OWASP Dependency-Check Suppression File
        Only test-only and dev-only dependencies are suppressed.
        Production dependencies are NOT suppressed — they must pass failBuildOnCVSS=7.
    -->

    <!-- Test-only dependencies (not shipped in production Docker images) -->
    <suppress>
        <notes><![CDATA[Testcontainers is test-only]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.testcontainers/.*@.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>
    <suppress>
        <notes><![CDATA[H2 database is test-only]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.h2database/h2@.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>
    <suppress>
        <notes><![CDATA[Lombok is compile-time annotation processor, not a runtime dependency]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.projectlombok/lombok@.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>

    <!-- Swagger UI / DOMPurify (dev-only API documentation, not exposed in production) -->
    <suppress>
        <notes><![CDATA[Swagger UI is dev-only, not exposed in production]]></notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>
    <suppress>
        <notes><![CDATA[Swagger UI is dev-only, not exposed in production]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.webjars/swagger-ui@.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>
</suppressions>
