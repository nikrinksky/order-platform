JWT_SECRET=your-production-secret-key-here-min-32-chars
POSTGRES_PASSWORD=your_db_password
REDIS_PASSWORD=your_redis_password

# First administrator, created by auth-service on startup. Leave empty to skip the bootstrap.
ADMIN_EMAIL=admin@orderplatform.local
ADMIN_PASSWORD=change-me-min-6-chars

# Comma-separated addresses of the proxies whose X-Forwarded-For the gateway believes.
# Leave empty when the gateway port is exposed directly: a header from an arbitrary peer is then
# ignored, otherwise a client would hand itself a fresh rate-limit bucket on every request.
GATEWAY_TRUSTED_PROXIES=

# Serve the OpenAPI documents and the Swagger UI. Set to false in an environment where the API
# shape must not be public; the gateway closes the paths with it as well.
SWAGGER_ENABLED=true