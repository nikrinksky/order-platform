<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">
        <!-- Disable LineLength check -->
        <module name="LineLength">
            <property name="max" value="120"/>
        </module>
        
        <!-- Disable FinalParameters check -->
        <module name="FinalParameters">
            <property name="tokens" value="PARAMETER_DEF"/>
        </module>
        
        <!-- Disable JavadocVariable check -->
        <module name="JavadocVariable">
            <property name="scope" value="public"/>
        </module>
        
        <!-- Disable DesignForExtension check -->
        <module name="DesignForExtension">
            <property name="severity" value="ignore"/>
        </module>
        
        <!-- Disable MagicNumber check for config classes -->
        <module name="MagicNumber">
            <property name="tokens" value="NUM_DOUBLE, NUM_INT, NUM_LONG, NUM_FLOAT"/>
        </module>
        
        <!-- Disable star imports -->
        <module name="AvoidStarImport">
            <property name="severity" value="warning"/>
        </module>
    </module>
</module>
