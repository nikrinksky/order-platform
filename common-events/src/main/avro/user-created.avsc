{
  "type": "record",
  "name": "UserCreatedEvent",
  "namespace": "com.orderplatform.events.user",
  "doc": "Emitted by auth-service when an account is registered or bootstrapped. Topic: user.created",
  "fields": [
    {"name": "id", "type": "string"},
    {"name": "username", "type": "string"},
    {"name": "email", "type": "string"},
    {"name": "firstName", "type": ["null", "string"], "default": null},
    {"name": "lastName", "type": ["null", "string"], "default": null},
    {"name": "roles", "type": {"type": "array", "items": "string"}},
    {"name": "isActive", "type": "boolean"},
    {"name": "createdAt", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null}
  ]
}
