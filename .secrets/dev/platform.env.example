# Copy to .secrets/dev/platform.env and fill in the values. `make inject-secrets` (or
# ./inject-secrets.ps1) turns this file into the Secret the pods read. The file itself is not in
# git: a signing key in a repository is a key that has to be rotated.

# Signing key of the JWTs. At least 32 characters - with a shorter one login returns 401 even for
# the right password, and the reason is only visible in the auth-service log.
JWT_SECRET=change-me-min-32-characters-long-secret

# First administrator, created by auth-service on startup. Leave both empty to skip the bootstrap;
# registration always hands out ROLE_USER, so without it nobody can create products or stock.
ADMIN_EMAIL=admin@orderplatform.local
ADMIN_PASSWORD=change-me-min-6-chars
